@model DashboardCard

@functions {
    // Задание 4: метод из @functions продублирован внутри partial —
    // partial работает только с типизированной моделью, без ViewBag
    string GetTrendLabel(Trend t) => t switch
    {
        Trend.Up => "Рост",
        Trend.Down => "Снижение",
        Trend.Stable => "Стабильно",
        _ => "Неизвестно"
    };

    // Доп. задание "Лёгкий": классификация значения карточки
    string GetValueClass(decimal value)
    {
        if (value < 0) return "Отрицательное";
        if (value < 1000) return "Низкое";
        if (value <= 10000) return "Среднее";
        return "Высокое";
    }
}

<div class="dashboard-card partial-card">
    <h3>@Model.Title</h3>
    <p class="card-value">
        @Model.Value @Model.Unit
        <span class="value-class">(@GetValueClass(Model.Value))</span>
    </p>
    <p class="card-trend">
        Тренд: @GetTrendLabel(Model.Trend)
        @if (Model.Trend == Trend.Up)
        {
            <span>↑</span>
        }
        else if (Model.Trend == Trend.Down)
        {
            <span>↓</span>
        }
        else
        {
            <span>→</span>
        }
    </p>

    @if (Model.Value < 0)
    {
        <span class="badge badge-negative">Отрицательное значение</span>
    }

    <p class="card-description">@Model.Description</p>
</div>
