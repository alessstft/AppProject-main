@model Product
@{
    // Задание "Сложный" (практическая 2): динамические классы и состояния через Razor + Bootstrap
    string borderClass;
    string? stateBadgeText;
    string stateBadgeClass;
    var addShadow = false;

    if (!Model.InStock)
    {
        borderClass = "border-danger";
        stateBadgeText = "Нет в наличии";
        stateBadgeClass = "bg-danger";
    }
    else if (Model.IsBigDiscount)
    {
        borderClass = "border-success border-discount";
        stateBadgeText = "Большая скидка";
        stateBadgeClass = "bg-success";
    }
    else if (Model.IsHit)
    {
        borderClass = "border-primary";
        stateBadgeText = "ХИТ";
        stateBadgeClass = "bg-warning text-dark";
        addShadow = true;
    }
    else
    {
        borderClass = "border-0";
        stateBadgeText = Model.HasDiscount ? $"-{Model.DiscountPercent}%" : null;
        stateBadgeClass = "bg-danger";
    }
}

<div class="col-12 col-md-6 col-lg-4">
    <div class="card h-100 product-card @borderClass @(addShadow ? "shadow-sm" : "")">

        <div class="position-relative">
            <img src="@Model.ImageUrl" class="card-img-top img-fluid" alt="@Model.Name" />

            @if (stateBadgeText != null)
            {
                <span class="badge @stateBadgeClass position-absolute top-0 end-0 m-2">@stateBadgeText</span>
            }
        </div>

        <div class="card-body d-flex flex-column">
            <h5 class="card-title">@Model.Name</h5>
            <p class="card-text text-muted small">@Model.Description</p>

            <div class="mt-auto">
                @* Цена товара *@
                <div class="mb-2">
                    @if (Model.HasDiscount)
                    {
                        <span class="text-muted text-decoration-line-through me-2">@Model.OldPrice!.Value.ToString("C0")</span>
                        <span class="fs-4 fw-bold text-danger">@Model.Price.ToString("C0")</span>
                    }
                    else
                    {
                        <span class="fs-4 fw-bold">@Model.Price.ToString("C0")</span>
                    }
                </div>

                @* Задание "Лёгкий" (практическая 2): адаптивная таблица цен (list-group) *@
                <ul class="list-group list-group-flush mb-3 price-table">
                    @if (Model.HasDiscount)
                    {
                        <li class="list-group-item d-flex flex-column flex-md-row justify-content-md-between align-items-md-center px-0">
                            <span class="text-muted">Обычная цена</span>
                            <span class="text-muted text-decoration-line-through">@Model.OldPrice!.Value.ToString("C0")</span>
                        </li>
                        <li class="list-group-item d-flex flex-column flex-md-row justify-content-md-between align-items-md-center px-0">
                            <span>Цена со скидкой</span>
                            <span class="fw-bold text-danger">@Model.Price.ToString("C0")</span>
                        </li>
                    }
                    else
                    {
                        <li class="list-group-item d-flex flex-column flex-md-row justify-content-md-between align-items-md-center px-0">
                            <span>Цена</span>
                            <span class="fw-bold">@Model.Price.ToString("C0")</span>
                        </li>
                    }
                </ul>

                @* Практическая 3, Задание 2.2: кнопка теперь не <form>, а обычная кнопка
                   с data-product-id — обработку берёт на себя cart.js (fetch AJAX). *@
                <button type="button"
                        class="btn btn-primary btn-checkout w-100 add-to-cart"
                        data-product-id="@Model.Id"
                        @(!Model.InStock ? "disabled" : "")>
                    @(Model.InStock ? "В корзину" : "Нет в наличии")
                </button>

                @* Доп. задание "Сложный": открывает модалку с деталями и отзывами (Promise.all) *@
                <button type="button"
                        class="btn btn-outline-secondary btn-sm w-100 mt-2 open-details"
                        data-product-id="@Model.Id">
                    Подробнее
                </button>
            </div>
        </div>
    </div>
</div>
