@model List<TaskBoard.Services.TaskItem>
@{
    ViewData["Title"] = "Список задач";
    string status = ViewBag.Status ?? "all";
}

<h1>Задачи</h1>

<p>
    <strong>Всего задач: @ViewBag.TotalCount, выполнено: @ViewBag.DoneCount</strong>
</p>

<a href="/tasks/create" class="btn btn-primary">Новая задача</a>

<div class="btn-group mt-3 mb-3" role="group">
    <a href="/tasks?status=all" class="btn btn-outline-secondary @(status == "all" ? "active" : "")">Все</a>
    <a href="/tasks?status=active" class="btn btn-outline-secondary @(status == "active" ? "active" : "")">В работе</a>
    <a href="/tasks?status=done" class="btn btn-outline-secondary @(status == "done" ? "active" : "")">Готово</a>
</div>

@if (!Model.Any())
{
    <p>Пока нет задач. Создайте первую!</p>
}
else
{
    <table class="table mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Заголовок</th>
                <th>Статус</th>
                <th>Дата</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in Model)
            {
                <tr>
                    <td>@task.Id</td>
                    <td>
                        <a href="/tasks/details/@task.Id">@task.Title</a>
                    </td>
                    <td>
                        @if (task.IsDone)
                        {
                            <span class="badge bg-success">Готово</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">В работе</span>
                        }
                    </td>
                    <td>@task.CreatedAt.ToString("dd.MM HH:mm")</td>
                    <td>
                        @if (!task.IsDone)
                        {
                            <form method="post" action="/tasks/done/@task.Id?status=@status" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">✓</button>
                            </form>
                        }
                        <form method="post" action="/tasks/delete/@task.Id?status=@status" class="d-inline" onsubmit="return confirm('Удалить?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">✕</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
