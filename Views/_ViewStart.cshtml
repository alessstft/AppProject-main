@{
    // Базовое поведение (задание 2.3): по умолчанию используется _Layout.
    // Дополнительное задание "Средний" расширяет эту логику: если контроллер
    // передал ViewData["Mode"] == "Print" — подставляется упрощённый
    // _PrintLayout (без шапки/навигации/подвала), иначе — обычный _AppLayout
    // с боковой панелью (двухуровневая вложенность в _Layout).
    //
    // Именно поэтому конкретные .cshtml (например, Dashboard/Index.cshtml)
    // не переопределяют Layout вручную — выбор полностью централизован здесь.
    Layout = (ViewData["Mode"] as string) == "Print" ? "_PrintLayout" : "_AppLayout";
}
